# Copier ce fichier vers .env puis renseigner les valeurs.
#   cp .env.example .env      (ou copie manuelle sous Windows)

# Identifiants d'un compte de test valide sur la cible.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Identifiants superuser pour l'API d'administration (création de produits).
ADMIN_USER=
ADMIN_PASSWORD=

# (Optionnel) Surcharger l'URL de base de la cible.
